# Copy to .env and fill in. NEVER commit the real .env (the block-secrets hook
# and .gitignore both guard against it).

# --- Slack (Phase 1) ---
# Create a Slack app, enable Socket Mode, add scopes: commands, channels:history, chat:write
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-socket-mode-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
TARGET_CHANNEL_ID=C0XXXXXXX
MESSAGE_FETCH_LIMIT=50

# --- LLM (Phase 2) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-6
MAX_DRAFTS=3

# --- Database (Phase 0+) ---
DATABASE_URL=postgresql+asyncpg://ghostwyre:ghostwyre@localhost:5432/ghostwyre

# --- Publishing (Phase 4) ---
# dry = no network (DryRunPublisher). Switch to x only after provisioning the X Basic tier.
PUBLISHER=dry
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Misc ---
LOG_LEVEL=INFO
