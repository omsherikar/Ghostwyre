# Copy to .env and fill in. NEVER commit the real .env (the block-secrets hook
# and .gitignore both guard against it).

# --- Slack (Phase 1) ---
# Create a Slack app, enable Socket Mode, and enable Interactivity (for the /setup
# voice modal). Scopes: commands, channels:history, chat:write, im:write (DM the
# /setup confirmation). Slash commands: /setup, /draft-post, /post-history.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-socket-mode-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
TARGET_CHANNEL_ID=C0XXXXXXX
MESSAGE_FETCH_LIMIT=50
# How many recent messages /draft-post scans to find + rank ideas (sift a busy channel).
IDEA_SCAN_LIMIT=150

# --- LLM (Phase 2) ---
# Provider: "anthropic" (default, Claude) or "groq" (free, OpenAI-compatible).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-6
# Used only when LLM_PROVIDER=groq (get a free key at console.groq.com/keys):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MAX_DRAFTS=3
# Output-token budgets. Drafting is long-form (a LinkedIn post + an X post), so it
# needs more headroom than extraction; raise DRAFT_MAX_TOKENS if you raise X_CHAR_LIMIT.
EXTRACT_MAX_TOKENS=1024
DRAFT_MAX_TOKENS=4096
# Ranking returns several scored ideas with evidence quotes — between extract and draft.
RANK_MAX_TOKENS=2048
# How many top-ranked ideas to surface for you to pick from.
IDEA_SHORTLIST_SIZE=3
# How many of your real posts (from /setup) to feed each draft as voice exemplars.
VOICE_EXEMPLAR_COUNT=4

# --- Database (Phase 0+) ---
DATABASE_URL=postgresql+asyncpg://ghostwyre:ghostwyre@localhost:5432/ghostwyre

# --- Publishing (Phase 4) ---
# dry = no network (DryRunPublisher, returns a fake link). Switch to x only after:
#   1) provisioning the paid X Basic (write) tier + OAuth 1.0a user-context tokens
#   2) installing the optional extra:  uv sync --extra x
PUBLISHER=dry
# The X approve/publish char ceiling. Default allows long posts; lower it to
# restrict. Actually posting >280 chars to X requires X Premium.
X_CHAR_LIMIT=25000
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Misc ---
LOG_LEVEL=INFO
